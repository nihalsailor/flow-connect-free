{
  "manifest_version": 3,
  "name": "Flow Connect Free — AI Agent Bridge for Google Flow",
  "short_name": "Flow Connect Free",
  "version": "1.0.0",
  "description": "Free, open-source bridge connecting coding agents to Google Flow image & video generation via MCP.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["result-capture.js"],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": ["flow-driver.js"],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Flow Connect Free",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
