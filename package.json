{
  "name": "flow-connect-free",
  "version": "1.0.0",
  "description": "Free, open-source bridge connecting coding agents to Google Flow via MCP and Chrome extension",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:extension": "npm run build --workspace=@flow-connect/extension",
    "build:bridge": "npm run build --workspace=@flow-connect/bridge",
    "start": "npm run start --workspace=@flow-connect/bridge",
    "mcp": "npm run mcp --workspace=@flow-connect/bridge",
    "dev:extension": "npm run dev --workspace=@flow-connect/extension"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
